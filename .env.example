# =============================================================================
# Example environment file for the Big Data Analytics & BI cinema project
# -----------------------------------------------------------------------------
# Copy this file to `.env` at the project root and adjust if needed.
# All scripts (preprocessing, dashboard, docker compose helpers) read these
# variables via python-dotenv or `set -a; source .env`.
# =============================================================================

# ----- HDFS connection ------------------------------------------------------
# When the PySpark job runs on the host (outside Docker) the namenode is
# reachable on localhost via the published port 9000. When the job runs
# inside the `spark` container the host is `namenode` instead. The docker
# compose definition already exports HDFS_HOST=namenode inside the spark
# container, so the value below applies to host-side execution.
HDFS_HOST=localhost
HDFS_PORT=9000

# ----- Project paths on HDFS ------------------------------------------------
PROJECT_HDFS_RAW_MOVIELENS=/project/cinema/raw/movielens
PROJECT_HDFS_RAW_TMDB=/project/cinema/raw/tmdb

# ----- MongoDB connection ---------------------------------------------------
# Use `mongodb` (the docker service name) when running inside the Spark
# container; use `localhost` when running on the host machine.
MONGO_URI=mongodb://mongodb:27017/
MONGO_DB=cinema_dw

# ----- MovieLens download ---------------------------------------------------
# URL of the MovieLens 25M archive used by scripts/download_movielens.sh.
MOVIELENS_URL=https://files.grouplens.org/datasets/movielens/ml-25m.zip
MOVIELENS_ZIP=ml-25m.zip
MOVIELENS_DIR=ml-25m
